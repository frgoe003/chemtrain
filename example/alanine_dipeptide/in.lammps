# input script for simulation of alanine dipeptide

plugin load ../../lammps_plugin/build/jaxconnector.so

units		real
boundary 	p p p
atom_style 	atomic

neighbor 	2.0 bin
neigh_modify 	every 10 delay 0 check no

read_data 	alanine_dipeptide.lmp
mass 		1 12.01078
mass 		2 12.01078
mass 		3 12.01078
mass 		4 14.00672
mass 		5 15.99943

pair_style  jaxnn
pair_coeff	* * 9 alanine_dipeptide_hlo.txt

velocity 	all create 298.15 23456789

fix 		1 all nvt temp 298.15 298.15 $(100.0*dt)
timestep 	0.5
thermo_style 	custom step pe ke etotal temp vol
thermo 		100
dump 		1 all custom 100 alanine_dipeptide.dump id type x y z

run 		1000
