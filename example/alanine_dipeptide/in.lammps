# input script for simulation of alanine dipeptide

plugin load ../../lammps_plugin/build/jaxconnector.so

dimension   3
units		real
boundary 	p p p
atom_style 	atomic

neighbor 	2.0 bin
neigh_modify 	every 1000 delay 5 check no

read_data 	alanine_dipeptide.lmp
mass 		1 15.99943
mass 		2 12.011
mass 		3 13.019
mass 		4 14.007
mass 		5 15.999

pair_style  jaxnn
pair_coeff	* * 9 ./neural_network.py

velocity 	all create 300.0 23456789

fix         1 all nve
fix         2 all langevin 300.0 300.0 $(100. * dt) 1530917

timestep 	0.05

# Log data
thermo 		100
thermo_style 	custom step pe ke etotal temp vol
dump 		1 all custom 500 alanine_dipeptide.lammpstrj id type x y z

run 		10000000
