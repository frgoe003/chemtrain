
plugin load ../../connector/build/jaxconnector.so

# 1) Basic settings
units real
dimension 3
atom_style atomic
pair_style jaxnn
boundary p p p

neighbor 	2.0 bin
neigh_modify 	every 1 delay 0 check no

# 2) Create random positions
region simulation_box block -100 100 -100 100 -100 100
create_box 1 simulation_box
create_atoms 1 random 135000 341341 simulation_box

# 3) Simulation settings
mass 1 18
pair_coeff * * 10 lennard_jones.mlir

# 4) Visualization
thermo 10
thermo_style custom step temp pe ke etotal press

# 5) Run
minimize 1.0e-5 1.0e-8 1000 10000

neigh_modify 	every 1 delay 0 check yes

# PART B - MOLECULAR DYNAMICS
# 4) Visualization
thermo 50
dump mydmp all atom 100 dump.lammpstrj

# 5) Run
fix         1 all nve
fix         2 all langevin 300.0 300.0 $(100. * dt) 1530917

timestep 2
run 10000



