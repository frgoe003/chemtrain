
plugin load ../../connector/build/jaxconnector.so

# 1) Basic settings
units real
dimension 3
atom_style atomic
pair_style jaxnn
boundary p p p

neighbor 	2.0 bin
neigh_modify 	every 1 delay 0 check yes once no

# comm_modify cutoff 1.0

# 2) Create random positions
region simulation_box block -50 50 -50 50 -50 50
# region simulation_box block -5 5 -5 5 -5 5

create_box 1 simulation_box

create_atoms 1 random 33000 341341 simulation_box
# create_atoms 1 random 30 341341 simulation_box

# 3) Simulation settings
mass 1 18
pair_coeff * * lennard_jones.pb cuda12 1.1 1.1

# 4) Visualization
thermo 10
thermo_style custom step temp pe ke etotal press

# 5) Run
min_style quickmin
minimize 1.0e-3 1.0e-5 10000 10000

neigh_modify 	every 10 delay 0 check yes

# PART B - MOLECULAR DYNAMICS
# 4) Visualization
thermo 50
dump mydmp all atom 100 dump.lammpstrj

# Must reset the velocity or the simulation explodes instantaneously
velocity all create 100.0 4928459 rot no dist gaussian

# 5) Run
fix         1 all nve
fix         2 all langevin 300.0 300.0 $(100. * dt) 1530917

timestep 1
run 10000



