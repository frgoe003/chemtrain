Bootstrap: docker
From: ubuntu:24.04

%files
    # Copy necessary files
    ./connector /chemtrain_deploy/connector
    ./lammps_plugin /chemtrain_deploy/lammps_plugin
    ./third_party /chemtrain_deploy/third_party
    ./.bazelversion /chemtrain_deploy/.bazelversion
    ./build.py /chemtrain_deploy/build.py
    ./jax.bazelrc /chemtrain_deploy/jax.bazelrc
    ./WORKSPACE /chemtrain_deploy/WORKSPACE


%environment


%environment
    export PATH="/chemtrain_deploy/lammps/build:$PATH"
    export LAMMPS_PLUGIN_PATH="/chemtrain_deploy/build/"
    export JCN_PJRT_PATH="/chemtrain_deploy/lib"

    # Point to OPENMPI binaries, libraries man pages
    export OPENMPI_DIR=/opt/openmpi-4.1.2
    export PATH="$OPENMPI_DIR/bin:$PATH"
    export LD_LIBRARY_PATH="$OPENMPI_DIR/lib:$LD_LIBRARY_PATH"
    export MANPATH=$OPENMPI_DIR/share/man:$MANPATH

%post

    # Update and install required packages
    apt-get update && apt-get install -y \
        bash \
        build-essential \
        cmake \
        clang \
        libstdc++-dev \
        gcc \
        gfortran \
        git \
        g++ \
        file \
        libfftw3-dev \
        libjpeg-dev \
        libpng-dev \
        libhdf5-dev \
        make \
        python3-dev \
        python3-pip \
        python3-numpy \
        python3-scipy \
        python3-matplotlib \
        python3-h5py \
        python3-yaml \
        python3-lxml \
        python3-six \
        python3-setuptools \
        python3-wheel \
        wget \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Information about the version of OPENMPI to use
    export OPENMPI_VERSION=4.1.2
    export OPENMPI_MINOR=4.1
    export OPENMPI_URL="https://download.open-mpi.org/release/open-mpi/v$OPENMPI_MINOR/openmpi-$OPENMPI_VERSION.tar.gz"
    export OPENMPI_DIR=/opt/openmpi-$OPENMPI_VERSION

    echo "Installing OPENMPI..."
    mkdir -p /tmp/openmpi
    mkdir -p /opt
    # Download
    cd /tmp/openmpi && wget -O openmpi-$OPENMPI_VERSION.tar.gz $OPENMPI_URL && tar xzf openmpi-$OPENMPI_VERSION.tar.gz
    # Compile and install
    cd /tmp/openmpi/openmpi-$OPENMPI_VERSION && ./configure --prefix=$OPENMPI_DIR && make install

    # Set env variables so we can compile our application
    export PATH=$OPENMPI_DIR/bin:$PATH
    export LD_LIBRARY_PATH=$OPENMPI_DIR/lib:$LD_LIBRARY_PATH


    export CUDA_COMPUTE_CAPABILITIES="sm_90"
    export CUDA_CUDNN_VERSION="9.5.0"
    export CUDA_VERSION="12.9.2"

    # Compile the connector
    cd /chemtrain-deploy && \
        python build.py \
            --build_gpu_pjrt_plugin \
            --enable_cuda \
            --cuda_version $CUDA_VERSION \
            --cuda_compute_capabilities $CUDA_COMPUTE_CAPABILITIES \
            --cudnn_version $CUDA_CUDNN_VERSION && \
        python build.py \
            --enable_cuda \
            --cuda_version $CUDA_VERSION \
            --cuda_compute_capabilities $CUDA_COMPUTE_CAPABILITIES \
            --cudnn_version $CUDA_CUDNN_VERSION && \

    # Fetch LAMMPS and build the plugin
    cd /chemtrain-deploy && \
        git clone https://github.com/lammps/lammps.git && \
        cd lammps && \
        git checkout stable_29Aug2024 && \
        mkdir build && \
        cd build && \
        cmake -D PKG_PLUGIN=yes ../cmake && \
        cmake --build . -j $(nproc)

    cd /chemtrain-deploy && \
        mkdir build && \
        cd build && \
        cmake -D LAMMPS_HEADER_DIR=/chemsim/lammps/src ../lammps_plugin && \
        cmake --build . -j $(nproc)


%labels
    Author Paul Fuchs
    Version 0.1
    chemsim-deploy LAMMPS plugin
